# Builds succeed with these unset. Runtime requires an isolated environment.
# Set secrets only in ignored .env.local or Vercel settings.
# Pooled runtime connection; preserve Neon's SSL parameters.
DATABASE_URL=""
# Direct (unpooled) connection for controlled Prisma migration commands.
DIRECT_URL=""
DATABASE_ENVIRONMENT="development"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with a cryptographically secure random generator; at least 32 characters.
BETTER_AUTH_SECRET=""
# Production database commands additionally require ALLOW_PRODUCTION_MIGRATION=true.
# Initial admin provisioning prompts for name/email/password; no defaults.
