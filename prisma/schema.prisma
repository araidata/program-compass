generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  editor
  viewer
}

model User {
  id               String                @id @default(uuid())
  name             String
  email            String                @unique
  emailVerified    Boolean               @default(false)
  image            String?
  role             Role                  @default(viewer)
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         Session[]
  accounts         Account[]
  changes          ChangeEvent[]
  assessments      Capability[]
  indicatorUpdates CapabilityIndicator[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// One internal organization. The migration constrains id to 'organization'.
model Organization {
  id        String   @id @default("organization")
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pillars   Pillar[]
}

model Pillar {
  id             String                   @id @default(uuid())
  key            String                   @unique
  name           String
  sortOrder      Int                      @default(0)
  organizationId String                   @default("organization")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  functions      OrganizationalFunction[]
  capabilities   CapabilityPillar[]
  positions      Position[]
}

model OrganizationalFunction {
  id             String       @id @default(uuid())
  name           String
  pillarId       String
  pillar         Pillar       @relation(fields: [pillarId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accountableFor Capability[]
  responsibilities Responsibility[]

  @@unique([pillarId, name])
}

model ApplicationSettings {
  id         String   @id @default("application")
  // Explicit safe setting; never store secrets in application settings.
  dateFormat String   @default("YYYY-MM-DD")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChangeEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  // Only allowlisted administrative fields; never passwords or tokens.
  details    Json
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([entityType, entityId])
}

enum ReviewState {
  draft
  submitted
  reviewed
}

enum Confidence {
  low
  medium
  high
}

enum IndicatorDirection {
  higher
  lower
}

// Capability catalogue entry plus its current assessment. The catalogue code and
// framework function come from reference data; assessment fields are observations.
// currentLevel/targetLevel null means unassessed or no target, never zero.
model Capability {
 annualTargets AnnualCapabilityTarget[]
 financialCosts FinancialCost[]
 workActivities WorkActivity[]
  id                    String                         @id @default(uuid())
  catalogue             String                         @default("reference-baseline-1")
  code                  String                         @unique
  groupCode             String
  name                  String
  description           String?
  sortOrder             Int                            @default(0)
  applicable            Boolean                        @default(true)
  currentLevel          Int?
  targetLevel           Int?
  scaleVersion          String                         @default("provisional-1")
  confidence            Confidence?
  rationale             String?
  reviewState           ReviewState                    @default(draft)
  targetDate            DateTime?                      @db.Date
  accountableFunctionId String?
  accountableFunction   OrganizationalFunction?        @relation(fields: [accountableFunctionId], references: [id], onDelete: SetNull)
  assessedAt            DateTime?
  assessedById          String?
  assessorLabel         String?
  assessedBy            User?                          @relation(fields: [assessedById], references: [id], onDelete: SetNull)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  pillars               CapabilityPillar[]
  indicators            CapabilityIndicator[]
  requirements          CapabilityRequirementMapping[]
  ownerPersonId         String?
  ownerPerson           Person?                        @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  snapshots             CapabilitySnapshot[]
  responsibilities      Responsibility[]
  planningIssues        PlanningIssue[]
  initiatives           InitiativeCapability[]
  technologies          Technology[]
  objectives            ObjectiveCapability[]
  threats               ThreatCapability[]

  @@index([groupCode, sortOrder])
}

// Capabilities may span pillars; no exclusive pillar ownership.
model CapabilityPillar {
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  pillarId     String
  pillar       Pillar     @relation(fields: [pillarId], references: [id], onDelete: Restrict)

  @@id([capabilityId, pillarId])
  @@index([pillarId])
}

// Operational KPI for one capability. Boundaries follow the reference
// baseline: higher is better passes at >= passThreshold and fails below
// failThreshold; lower is better passes at <= passThreshold and fails above
// failThreshold; values between are at risk. value null means no data.
model CapabilityIndicator {
  id            String             @id @default(uuid())
  capabilityId  String
  capability    Capability         @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  // Stable catalogue identifier (for example GV.01-1); null for local KPIs.
  catalogueKey  String?            @unique
  sortOrder     Int                @default(0)
  name          String
  unit          String             @default("%")
  direction     IndicatorDirection @default(higher)
  passThreshold Decimal            @db.Decimal(14, 4)
  failThreshold Decimal            @db.Decimal(14, 4)
  value         Decimal?           @db.Decimal(14, 4)
  measuredAt    DateTime?          @db.Date
  updatedById   String?
  updatedBy     User?              @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([capabilityId, name])
}

// Versioned external framework reference (for example NIST CSF 2.0 or the
// CJIS Security Policy 6.0). Reference data only; loaded from authoritative
// sources in a later slice. Organizational assessments stay on Capability.
model Framework {
  id           String                 @id @default(uuid())
  key          String
  name         String
  version      String
  sourceUrl    String?
  sourceHash   String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  requirements FrameworkRequirement[]

  @@unique([key, version])
}

// Official requirement, function, category or control, with its hierarchy.
model FrameworkRequirement {
 workActivities WorkActivity[]
  id          String                         @id @default(uuid())
  frameworkId String
  framework   Framework                      @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  identifier  String
  title       String
  description String?
  sourceUrl   String?
  sourcePage  Int?
  kind        String @default("requirement")
  deadline    DateTime? @db.Date
  assessment  RequirementAssessment?
  parentId    String?
  parent      FrameworkRequirement?          @relation("RequirementHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    FrameworkRequirement[]         @relation("RequirementHierarchy")
  sortOrder   Int                            @default(0)
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  mappings    CapabilityRequirementMapping[]
  responsibilities Responsibility[]
  planningIssues PlanningIssue[]
  initiatives Initiative[]
  technologies Technology[]

  @@unique([frameworkId, identifier])
}

// A capability is assessed once and mapped to many requirements; a mapping
// never creates a second maturity value.
model CapabilityRequirementMapping {
  capabilityId  String
  capability    Capability           @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   FrameworkRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  rationale     String?
  reviewed      Boolean @default(false)
  createdAt     DateTime             @default(now())

  @@id([capabilityId, requirementId])
  @@index([requirementId])
}

// Personnel are planning records, independent of application login accounts.
model Person {
 capacityAssignments CapacityAssignment[]
 skillObservations SkillObservation[]
  id           String       @id @default(uuid())
  name         String
  title        String
  managerId    String?
  manager      Person?      @relation("ReportingLine", fields: [managerId], references: [id], onDelete: Restrict)
  reports      Person[]     @relation("ReportingLine")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  positions    Position[]
  capabilities Capability[]
  objectives   BusinessObjective[]
  responsibilities Responsibility[]
  planningIssues PlanningIssue[]
  initiatives Initiative[]
  technologies Technology[]

  @@index([managerId])
  requirementAssessments RequirementAssessment[]
}

enum PositionState {
  authorized
  proposed
  retired
}

model Position {
 scenarioItems ScenarioItem[]
 financialCosts FinancialCost[]
 capacityAssignments CapacityAssignment[]
  id             String        @id @default(uuid())
  title          String
  pillarId       String
  pillar         Pillar        @relation(fields: [pillarId], references: [id], onDelete: Restrict)
  personId       String?
  person         Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  state          PositionState @default(proposed)
  fte            Decimal       @db.Decimal(8, 4)
  annualCost     Decimal?      @db.Decimal(16, 2)
  currency       String        @default("USD")
  startYear      Int?
  justification  String?
  responsibilities Responsibility[]
  initiatives Initiative[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([pillarId])
  @@index([personId])
}

// Immutable assessment snapshots; the live capability remains authoritative.
model PlanningCycle {
  id             String               @id @default(uuid())
  name           String
  asOf           DateTime             @db.Date
  notes          String?
  createdAt      DateTime             @default(now())
  snapshots      CapabilitySnapshot[]
  dataset        Json?
  summary        Json?
}

model CapabilitySnapshot {
  cycleId        String
  cycle          PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  capabilityId   String
  capability     Capability    @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  // Full serializable assessment, indicators and scope at capture time.
  assessment     Json

  @@id([cycleId, capabilityId])
}

model OrganizationProfile {
  id                   String   @id @default("organization")
  mission              String?
  sector               String?
  criticalServices     String?
  dependencies         String?
  publicSafetyImpact   String?
  regulatoryDrivers    String?
  complexityNotes      String?
  updatedAt            DateTime @updatedAt
}

model BusinessObjective {
  id           String                @id @default(uuid())
  title        String
  rationale    String
  priority     Int
  ownerId      String?
  owner        Person?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  capabilities ObjectiveCapability[]
  threats      ThreatObjective[]
  initiatives  Initiative[]
}

model BusinessThreat {
  id           String             @id @default(uuid())
  title        String
  scenario     String
  likelihood   Int?
  impact       Int?
  basis        String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  objectives   ThreatObjective[]
  capabilities ThreatCapability[]
}

model ObjectiveCapability {
  objectiveId  String
  objective    BusinessObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  capabilityId String
  capability   Capability        @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  @@id([objectiveId, capabilityId])
}

model ThreatObjective {
  threatId    String
  threat      BusinessThreat    @relation(fields: [threatId], references: [id], onDelete: Cascade)
  objectiveId String
  objective   BusinessObjective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  @@id([threatId, objectiveId])
}

model ThreatCapability {
  threatId     String
  threat       BusinessThreat @relation(fields: [threatId], references: [id], onDelete: Cascade)
  capabilityId String
  capability   Capability     @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  @@id([threatId, capabilityId])
}

// Immutable method versions; live reads select the newest version. Snapshots retain their version.
model PlanningMethodVersion {
 scenarios PlanningScenario[]
  id            String   @id @default(uuid())
  values        Json
  basis         String
  effectiveDate DateTime @db.Date
  provisional   Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Responsibility {
 workActivities WorkActivity[]
 capacityAssignments CapacityAssignment[]
 coverageConstraints WorkforceConstraint[] @relation("CoverageResponsibility")
 conflictingConstraints WorkforceConstraint[] @relation("ConflictingResponsibility")
 id String @id @default(uuid())
 title String
 description String
 source String
 functionId String
 function OrganizationalFunction @relation(fields:[functionId],references:[id],onDelete:Restrict)
 ownerId String?
 owner Person? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 capabilities Capability[]
 positions Position[]
 requirements FrameworkRequirement[]
 technologies Technology[]
}

model PlanningIssue {
 id String @id @default(uuid())
 title String
 description String
 source String
 consequence String
 ownerId String?
 owner Person? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
 openedDate DateTime @db.Date
 dueDate DateTime? @db.Date
 status String @default("open")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 capabilities Capability[]
 requirements FrameworkRequirement[]
 initiatives Initiative[]
}

model Initiative {
 scenarioItems ScenarioItem[]
 financialCosts FinancialCost[]
 id String @id @default(uuid())
 title String
 description String
 justification String
 outcomes String
 deferral String
 ownerId String?
 owner Person? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
 investmentState String @default("proposed")
 status String @default("planned")
 priority Int @default(3)
 startDate DateTime? @db.Date
 endDate DateTime? @db.Date
 effortHours Decimal? @db.Decimal(16,4)
 oneTimeCost Decimal? @db.Decimal(16,2)
 recurringCost Decimal? @db.Decimal(16,2)
 currency String @default("USD")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 capabilities InitiativeCapability[]
 issues PlanningIssue[]
 objectives BusinessObjective[]
 requirements FrameworkRequirement[]
 positions Position[]
 technologies Technology[]
 dependencies Initiative[] @relation("InitiativeDependencies")
 dependents Initiative[] @relation("InitiativeDependencies")
}

model InitiativeCapability {
 initiativeId String
 initiative Initiative @relation(fields:[initiativeId],references:[id],onDelete:Cascade)
 capabilityId String
 capability Capability @relation(fields:[capabilityId],references:[id],onDelete:Restrict)
 uplift Int @default(0)
 rationale String
 @@id([initiativeId,capabilityId])
}

model Technology {
 decision String @default("inventory")
 deploymentState String @default("unknown")
 retirementDate DateTime? @db.Date
 alternativesFor Technology[] @relation("TechnologyAlternatives")
 alternativeOptions Technology[] @relation("TechnologyAlternatives")
 scenarioItems ScenarioItem[]
 financialCosts FinancialCost[]
 id String @id @default(uuid())
 title String
 vendor String
 category String
 description String
 source String
 alternatives String
 deficiencyType String @default("technology")
 state String @default("proposed")
 ownerId String?
 owner Person? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
 coveragePercent Decimal? @db.Decimal(7,4)
 utilizationPercent Decimal? @db.Decimal(7,4)
 startDate DateTime? @db.Date
 renewalDate DateTime? @db.Date
 annualLicenseCost Decimal? @db.Decimal(16,2)
 annualOperatingCost Decimal? @db.Decimal(16,2)
 implementationCost Decimal? @db.Decimal(16,2)
 currency String @default("USD")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 capabilities Capability[]
 requirements FrameworkRequirement[]
 responsibilities Responsibility[]
 initiatives Initiative[]
 dependencies Technology[] @relation("TechnologyDependencies")
 dependents Technology[] @relation("TechnologyDependencies")
}

model RequirementAssessment {
 id String @id @default(uuid())
 requirementId String @unique
 requirement FrameworkRequirement @relation(fields:[requirementId],references:[id],onDelete:Restrict)
 applicability String @default("unknown")
 implementation String @default("unassessed")
 currentLevel Int?
 targetLevel Int?
 notes String?
 ownerId String?
 owner Person? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
 applicableDeadline DateTime? @db.Date
 scaleVersion String @default("provisional-1")
 assessedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model NiceElement {
 workActivities WorkActivity[]
 skillObservations SkillObservation[]
 coverageConstraints WorkforceConstraint[]
 id String @id
 version String
 identifier String
 kind String
 title String
 description String
 sourceUrl String
 sourceHash String
 outgoing NiceRelation[] @relation("NiceSource")
 incoming NiceRelation[] @relation("NiceTarget")
 @@unique([version,identifier])
}
model NiceRelation {
 sourceId String
 source NiceElement @relation("NiceSource",fields:[sourceId],references:[id],onDelete:Restrict)
 targetId String
 target NiceElement @relation("NiceTarget",fields:[targetId],references:[id],onDelete:Restrict)
 @@id([sourceId,targetId])
}

// Unique activities are counted once regardless of capability/framework mappings.
model WorkActivity {
 id String @id @default(uuid())
 workKey String @unique
 title String
 responsibilityId String
 responsibility Responsibility @relation(fields:[responsibilityId],references:[id],onDelete:Restrict)
 source String
 effectiveDate DateTime @db.Date
 provisional Boolean @default(true)
 year Int
 volume Decimal? @db.Decimal(16,4)
 frequency Decimal? @db.Decimal(16,4)
 hoursPerUnit Decimal? @db.Decimal(16,4)
 fixedHours Decimal? @db.Decimal(16,4)
 projectHours Decimal? @db.Decimal(16,4)
 growth Decimal? @db.Decimal(12,6)
 outsourcedHours Decimal? @db.Decimal(16,4)
 automatedHours Decimal? @db.Decimal(16,4)
 productiveHoursPerFte Decimal? @db.Decimal(12,4)
 workType String
 active Boolean @default(true)
 capabilities Capability[]
 requirements FrameworkRequirement[]
 niceElements NiceElement[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model CapacityAssignment {
 id String @id @default(uuid())
 title String
 positionId String
 position Position @relation(fields:[positionId],references:[id],onDelete:Restrict)
 personId String?
 person Person? @relation(fields:[personId],references:[id],onDelete:Restrict)
 responsibilityId String
 responsibility Responsibility @relation(fields:[responsibilityId],references:[id],onDelete:Restrict)
 startDate DateTime @db.Date
 endDate DateTime? @db.Date
 allocatedFte Decimal @db.Decimal(8,4)
 paidHours Decimal? @db.Decimal(12,4)
 productiveHours Decimal? @db.Decimal(12,4)
 runShare Decimal @db.Decimal(8,4)
 source String
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model SkillObservation {
 id String @id @default(uuid())
 title String
 personId String
 person Person @relation(fields:[personId],references:[id],onDelete:Restrict)
 niceElementId String
 niceElement NiceElement @relation(fields:[niceElementId],references:[id],onDelete:Restrict)
 currentLevel Int?
 targetLevel Int?
 assessedDate DateTime @db.Date
 notes String
 source String
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([personId,niceElementId])
}
model WorkforceConstraint {
 id String @id @default(uuid())
 title String
 responsibilityId String
 responsibility Responsibility @relation("CoverageResponsibility",fields:[responsibilityId],references:[id],onDelete:Restrict)
 conflictingResponsibilityId String?
 conflictingResponsibility Responsibility? @relation("ConflictingResponsibility",fields:[conflictingResponsibilityId],references:[id],onDelete:Restrict)
 kind String
 minimumPeople Int?
 minimumFte Decimal? @db.Decimal(8,4)
 niceElementId String?
 niceElement NiceElement? @relation(fields:[niceElementId],references:[id],onDelete:Restrict)
 minimumSkill Int?
 source String
 consequence String
 alternatives String
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model PlanningScenario {
 id String @id @default(uuid())
 title String
 kind String
 source String
 methodVersionId String
 methodVersion PlanningMethodVersion @relation(fields:[methodVersionId],references:[id],onDelete:Restrict)
 startYear Int
 fiscalStartMonth Int
 currency String
 active Boolean @default(true)
 items ScenarioItem[]
 targets AnnualCapabilityTarget[]
 budgets ScenarioBudget[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model ScenarioItem {
 id String @id @default(uuid())
 scenarioId String
 scenario PlanningScenario @relation(fields:[scenarioId],references:[id],onDelete:Restrict)
 title String
 initiativeId String?
 initiative Initiative? @relation(fields:[initiativeId],references:[id],onDelete:Restrict)
 positionId String?
 position Position? @relation(fields:[positionId],references:[id],onDelete:Restrict)
 technologyId String?
 technology Technology? @relation(fields:[technologyId],references:[id],onDelete:Restrict)
 included Boolean
 startDate DateTime? @db.Date
 endDate DateTime? @db.Date
 source String
 deferral String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([scenarioId,initiativeId])
 @@unique([scenarioId,positionId])
 @@unique([scenarioId,technologyId])
}
model AnnualCapabilityTarget {
 id String @id @default(uuid())
 scenarioId String
 scenario PlanningScenario @relation(fields:[scenarioId],references:[id],onDelete:Restrict)
 capabilityId String
 capability Capability @relation(fields:[capabilityId],references:[id],onDelete:Restrict)
 title String
 year Int
 level Int
 source String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([scenarioId,capabilityId,year])
}
model ScenarioBudget {
 id String @id @default(uuid())
 scenarioId String
 scenario PlanningScenario @relation(fields:[scenarioId],references:[id],onDelete:Restrict)
 title String
 year Int
 amount Decimal? @db.Decimal(16,2)
 source String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([scenarioId,year])
}
model FinancialCost {
 id String @id @default(uuid())
 identity String @unique
 title String
 positionId String?
 position Position? @relation(fields:[positionId],references:[id],onDelete:Restrict)
 technologyId String?
 technology Technology? @relation(fields:[technologyId],references:[id],onDelete:Restrict)
 initiativeId String?
 initiative Initiative? @relation(fields:[initiativeId],references:[id],onDelete:Restrict)
 capabilityId String?
 capability Capability? @relation(fields:[capabilityId],references:[id],onDelete:Restrict)
 component String
 category String
 frequency String
 amount Decimal? @db.Decimal(16,2)
 currency String
 startDate DateTime? @db.Date
 endDate DateTime? @db.Date
 escalationPercent Decimal? @db.Decimal(8,4)
 baseline Boolean
 saving Boolean
 source String
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model ImportPreview {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 expiresAt DateTime
 appliedAt DateTime?
 schemaHash String
 payloadHash String
 baseHash String
 changes Json
 payload Json
}

model DataUpload {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 expiresAt DateTime
 finalizedAt DateTime?
 byteLength Int
 partCount Int
 sha256 String
 parts DataUploadPart[]
}
model DataUploadPart {
 uploadId String
 upload DataUpload @relation(fields:[uploadId],references:[id],onDelete:Cascade)
 part Int
 base64 String
 @@id([uploadId,part])
}
